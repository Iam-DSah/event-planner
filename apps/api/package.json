{
  "name": "@event-planner/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "knex": "tsx --env-file-if-exists=../../.env ../../node_modules/knex/bin/cli.js --knexfile ./src/db/knexfile.ts",
    "migrate:make": "npm run knex -- migrate:make -x ts",
    "migrate:latest": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:status": "npm run knex -- migrate:status",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=../../.env --test src/**/*.test.ts"
  },
  "dependencies": {
    "@event-planner/shared": "*",
    "@node-rs/argon2": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.12.0",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.6",
    "typescript": "^5.7.3"
  }
}
