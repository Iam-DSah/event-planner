{
  "name": "event-planning-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @event-planner/api",
    "//dev:web": "npm workspaces has no parallel runner, so days 7+ mean two terminals: `npm run dev` for the API, `npm run dev:web` for Vite.",
    "dev:web": "npm run dev -w @event-planner/web",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "migrate:make": "npm run migrate:make -w @event-planner/api --",
    "migrate:latest": "npm run migrate:latest -w @event-planner/api",
    "migrate:rollback": "npm run migrate:rollback -w @event-planner/api",
    "migrate:status": "npm run migrate:status -w @event-planner/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @event-planner/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  }
}
