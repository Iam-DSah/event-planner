# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_planner
DB_USER=eventplanner
DB_PASSWORD=eventplanner_password
DB_ROOT_PASSWORD=rootpassword

# ─── Auth ────────────────────────────────────────────────────────────────────
# HS256 signing key for access tokens. The security of every token rests
# entirely on this value's entropy: a weak secret is recovered offline from a
# single captured token, with no login attempts and nothing in the logs.
# RFC 7518 §3.2 requires at least 256 bits for HS256; lib/env.ts enforces a
# 32-character floor and the app refuses to start below it.
#
#   Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# The placeholder below is NOT a secret — replace it.
JWT_SECRET=replace-me-with-32-plus-random-characters

# ─── Frontend ────────────────────────────────────────────────────────────────
# The single origin the API will accept credentialed browser requests from.
# Must be scheme + host + port with no trailing slash, and must match the Vite
# dev server exactly. If Vite moves to 5174 the API still answers, but the
# BROWSER discards the response — enforcement is client-side (see cors.ts).
# Optional: middleware/cors.ts defaults to the value below if unset.
WEB_ORIGIN=http://localhost:5173
